# Centralized Postgres shared by the whole fleet (14 §3). Matches docker-compose.yml defaults.
# Copy to `.env` for local integration tests: `cp .env.example .env`.
DATABASE_URL=postgres://funding:funding@localhost:5432/funding_drop

# Binance USD-M **futures testnet** credentials — used only by the env-gated live smokes
# (`test/integration/binance-*.integration.test.ts`, excluded from `npm run verify`). Set
# RUN_BINANCE_PRIVATE_INTEGRATION=1 with both keys present to run them; unset → they skip.
# Get keys at https://testnet.binancefuture.com/. Do NOT commit real values to this file.
RUN_BINANCE_PRIVATE_INTEGRATION=0
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
