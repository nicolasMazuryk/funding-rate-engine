# Instance identity + wiring (09 §2). One running instance = one exchange, one strategy,
# one sub-account. Required by the composition root (`npm start` → src/main.ts).
EXCHANGE=binance
STRATEGY=s1
SUBACCOUNT=dev
KILL_SWITCH=off
LOG_LEVEL=info

# Live venue credentials, resolved off EXCHANGE as `${EXCHANGE}_API_KEY`/`_API_SECRET`
# (09 §2) — so only the selected venue's pair is required. The `ADAPTER=sim` dev smoke
# below never calls the venue, so any non-empty placeholder satisfies startup validation.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Bybit (task 0420; EXCHANGE=bybit). No passphrase on this venue.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# OKX (task 0430; EXCHANGE=okx). The first venue with a **passphrase** — the third
# credential is chosen when the key is created and is required for every signed request
# (09 §2 already parses `${EXCHANGE}_API_PASSPHRASE`; the OKX factory is its first reader).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Bitget (task 0440; EXCHANGE=bitget). Passphrase venue too — the SDK calls it `apiPass`,
# ccxt calls it `password`. The account must be upgraded to a **Unified Trading Account**:
# the adapter targets the v3/UTA surface and fails loud rather than falling back to v2 mix.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Dev smoke (task 0280): boot a real instance against the credential-free sim venue and
# confirm a clean SIGTERM shutdown — no venue creds, no live orders. Requires the identity
# vars above (EXCHANGE stays `binance` so the s1-binance.yaml still loads) and Postgres
# reachable at DATABASE_URL (only touched once an intent persists, so a bare boot needs none):
#   ADAPTER=sim npm start
# ADAPTER defaults to `binance` (the real adapter) when unset.

# NOTE — the **live tier** (`npm run test:live`, task 0470) does NOT read this file. Its
# per-sub-account production credentials live in the gitignored
# `config/subaccounts.secrets.yaml` (template: `config/subaccounts.secrets.example.yaml`),
# joined on `(exchange, strategy)` to the committed, secret-free `config/subaccounts.yaml`.
# One instance's own runtime creds stay above; a fleet of sub-accounts does not fit in env.

# Centralized Postgres shared by the whole fleet (14 §3). Matches docker-compose.yml defaults.
# Copy to `.env` for local integration tests: `cp .env.example .env`.
DATABASE_URL=postgres://funding:funding@localhost:5432/funding_drop

# Binance USD-M **futures testnet** credentials — used by `npm run test:testnet -- --venue
# binance` (task 0260, excluded from `npm run verify`) and `npm run capture` (task 0250).
# Absent either key: `test:testnet` reports every check `skip: no credentials` and exits 0
# (never a red build); `capture --set private-ws|orders` fails loud instead (a capture run
# is opt-in, so a missing key there is a mistake worth surfacing, not a skip).
# Get keys at https://testnet.binancefuture.com/. Do NOT commit real values to this file.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Bybit **testnet** credentials — same contract, for `npm run test:testnet -- --venue bybit`
# and `npm run capture -- --venue bybit` (task 0420). Get keys at https://testnet.bybit.com/.
# The account must be a Unified Trading Account: the `account-setup` check flips it to
# account-wide ISOLATED_MARGIN (decision D1). Do NOT commit real values to this file.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# OKX **demo trading** credentials — same contract, for `npm run test:testnet -- --venue okx`
# and `npm run capture -- --venue okx` (task 0430). OKX has no separate testnet domain or
# signup: demo trading is a flag on the same host family (`demoTrading: true` on the SDK
# clients, ccxt `setSandboxMode(true)`), and demo keys are created under the same account at
# https://www.okx.com/trade-demo. All three values are required — a demo key without its
# passphrase cannot sign. Do NOT commit real values to this file.
OKX_TESTNET_API_KEY=
OKX_TESTNET_API_SECRET=
OKX_TESTNET_PASSPHRASE=

# Bitget **demo trading** credentials — same contract, for `npm run test:testnet -- --venue
# bitget` and `npm run capture -- --venue bitget` (task 0440). Bitget has no testnet host:
# demo is a **product type** (`SUSDT-FUTURES`, 3 symbols settled in `SUSDT`) reached with
# `demoTrading: true` / ccxt `setSandboxMode(true)` on the same account. All three values are
# required — Bitget signs with key + secret + passphrase. Do NOT commit real values here.
BITGET_TESTNET_API_KEY=
BITGET_TESTNET_API_SECRET=
BITGET_TESTNET_PASSPHRASE=
