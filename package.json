{
  "name": "funding-drop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --experimental-transform-types --import ./scripts/register-ts.mjs src/main.ts",
    "replay": "node --experimental-transform-types --import ./scripts/register-ts.mjs scripts/replay.ts",
    "capture": "node --experimental-transform-types --import ./scripts/register-ts.mjs scripts/capture.ts",
    "analytics": "node --experimental-transform-types --import ./scripts/register-ts.mjs scripts/analytics.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:testnet": "node --experimental-transform-types --import ./scripts/register-ts.mjs scripts/testnet.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/persistence/db/migrate.ts",
    "verify": "npm run typecheck && npm run check && npm run test"
  },
  "dependencies": {
    "binance": "^3.6.1",
    "bitget-api": "^3.2.1",
    "bybit-api": "^4.7.1",
    "ccxt": "^4.5.67",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.6",
    "kucoin-api": "^2.6.1",
    "okx-api": "^3.2.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.5",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
